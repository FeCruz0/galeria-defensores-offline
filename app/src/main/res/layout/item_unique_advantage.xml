<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="4dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/card_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Nome exibido na ficha; grupo e custo ocultados -->
        <TextView
            android:id="@+id/text_ua_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Humano"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/text_primary" />

        <!-- Usado pelo adapter de seleção para mostrar o grupo -->
        <TextView
            android:id="@+id/text_ua_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Humanos"
            android:textSize="12sp"
            android:textColor="#9CA3AF"
            android:visibility="gone" />

        <!-- Custo — oculto no card da ficha, visível no adapter de seleção -->
        <TextView
            android:id="@+id/text_ua_cost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 pts"
            android:textColor="#3B82F6"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Benefícios/fraquezas — visível no adapter de seleção -->
        <TextView
            android:id="@+id/text_ua_benefits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Benefícios: ..."
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:visibility="gone" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
